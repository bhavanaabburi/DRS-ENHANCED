<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drs.drs.initial.controller.IncidentsController"
            fitToWidth="true"
            vbarPolicy="AS_NEEDED"
            hbarPolicy="NEVER"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;">

    <VBox spacing="20" 
          style="-fx-padding: 25; -fx-background-color: #F0F4F8;"
          VBox.vgrow="ALWAYS">

        <!-- ============================================= -->
        <!-- HEADER SECTION -->
        <!-- ============================================= -->
        <VBox spacing="5">
            <Label text="VIEW INCIDENTS" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #FF6B6B;">
                <font>
                    <Font name="Segoe UI Bold" size="32.0"/>
                </font>
            </Label>
            <Label text="Monitor and track active incidents in the disaster response system"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
        </VBox>

        <!-- ============================================= -->
        <!-- FILTER SECTION -->
        <!-- ============================================= -->
        <VBox spacing="10" 
              style="-fx-border-color: #FF6B6B; -fx-border-width: 2; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #FFE6E6;">

            <Label text="FILTER INCIDENTS" 
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #8B0000;"/>

            <!-- Filter Row -->
            <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
                <Label text="Filter by:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterComboBox" 
                          prefHeight="35"
                          prefWidth="200"
                          style="-fx-padding: 8; -fx-font-size: 12px; -fx-border-radius: 3;"/>
            </HBox>

        </VBox>

        <!-- ============================================= -->
        <!-- MESSAGE LABEL -->
        <!-- ============================================= -->
        <Label fx:id="messageLabel" 
               text="Active Incidents: 8"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #FF6B6B;"/>

        <!-- ============================================= -->
        <!-- INCIDENTS LIST SECTION -->
        <!-- ============================================= -->
        <VBox spacing="15" 
              style="-fx-border-color: #CCCCCC; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #FAFAFA;">

            <Label text="INCIDENT LIST" 
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F5B99;"/>

            <!-- Incidents will be added dynamically here -->
            <VBox fx:id="incidentsList" 
                  spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-alignment: TOP_LEFT;"/>

        </VBox>

        <!-- ============================================= -->
        <!-- FOOTER BUTTONS -->
        <!-- ============================================= -->
        <HBox spacing="10" style="-fx-alignment: CENTER;">
            <Button fx:id="backButton" 
                    text="BACK TO DASHBOARD"
                    prefWidth="200"
                    style="-fx-padding: 12px 20px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #6C757D; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 4;"/>
        </HBox>

        <VBox style="-fx-padding: 10;"/>

    </VBox>

</ScrollPane>
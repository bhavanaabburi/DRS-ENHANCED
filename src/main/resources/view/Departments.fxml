<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drs.drs.initial.controller.DepartmentsController"
            fitToWidth="true"
            vbarPolicy="AS_NEEDED"
            hbarPolicy="NEVER"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;">

    <VBox spacing="20" 
          style="-fx-padding: 25; -fx-background-color: #F0F4F8;"
          VBox.vgrow="ALWAYS">

        <!-- HEADER SECTION -->
        <VBox spacing="5">
            <Label text="MANAGE DEPARTMENTS" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;">
                <font>
                    <Font name="Segoe UI Bold" size="32.0"/>
                </font>
            </Label>
            <Label text="Coordinate and manage emergency response departments"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
        </VBox>

        <!-- SEARCH AND FILTER SECTION -->
        <VBox spacing="10" 
              style="-fx-border-color: #2196F3; -fx-border-width: 2; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #E3F2FD;">

            <Label text="SEARCH AND FILTER DEPARTMENTS" 
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>

            <!-- Search Row -->
            <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
                <Label text="Search:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <TextField fx:id="searchField" 
                           promptText="Search by name, type, or ID..."
                           prefHeight="35"
                           HBox.hgrow="ALWAYS"
                           style="-fx-padding: 8; -fx-font-size: 12px; -fx-border-radius: 3;"/>
                <Button fx:id="searchButton"
                        text="SEARCH"
                        prefWidth="100"
                        style="-fx-padding: 10px 20px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 3;"/>
            </HBox>

            <!-- Filter Row -->
            <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
                <Label text="Filter by Status:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterComboBox" 
                          prefHeight="35"
                          prefWidth="200"
                          style="-fx-padding: 8; -fx-font-size: 12px; -fx-border-radius: 3;"/>
            </HBox>

        </VBox>

        <!-- MESSAGE LABEL -->
        <Label fx:id="messageLabel" 
               text="Displaying all departments"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #28A745;"/>

        <!-- DEPARTMENTS LIST SECTION -->
        <VBox spacing="15" 
              style="-fx-border-color: #CCCCCC; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #FAFAFA;">

            <Label text="DEPARTMENT LIST" 
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>

            <!-- Departments will be added dynamically here -->
            <VBox fx:id="departmentsList" 
                  spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-alignment: TOP_LEFT;"/>

        </VBox>

        <!-- FOOTER BUTTONS -->
        <HBox spacing="10" style="-fx-alignment: CENTER;">
            <Button fx:id="backButton" 
                    text="BACK TO DASHBOARD"
                    prefWidth="200"
                    style="-fx-padding: 12px 20px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #6C757D; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 4;"/>
        </HBox>

        <VBox style="-fx-padding: 10;"/>

    </VBox>

</ScrollPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drs.drs.initial.controller.TasksController"
            fitToWidth="true"
            vbarPolicy="AS_NEEDED"
            hbarPolicy="NEVER"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;">

    <VBox spacing="20" 
          style="-fx-padding: 25; -fx-background-color: #F0F4F8;"
          VBox.vgrow="ALWAYS">

        <!-- HEADER SECTION -->
        <VBox spacing="5">
            <Label text="MANAGE RESPONSE TASKS" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;">
                <font>
                    <Font name="Segoe UI Bold" size="32.0"/>
                </font>
            </Label>
            <Label text="Assign and track emergency response tasks"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
        </VBox>

        <!-- FILTER SECTION -->
        <VBox spacing="10" 
              style="-fx-border-color: #9C27B0; -fx-border-width: 2; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: #F3E5F5;">

            <Label text="FILTER TASKS" 
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A148C;"/>

            <!-- Filter Row -->
            <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
                <Label text="Filter by Status:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterComboBox" 
                          prefHeight="35"
                          prefWidth="200"
                          style="-fx-padding: 8; -fx-font-size: 12px; -fx-border-radius: 3;"/>
            </HBox>

        </VBox>

        <!-- ADMIN / COORDINATOR: NEW UNASSIGNED TASK -->
        <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
            <Button text="CREATE UNASSIGNED TASK"
                    onAction="#createUnassignedTask"
                    style="-fx-background-color: #7B1FA2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18;"/>
            <Label text="Create a Pending task, then use Auto-Assign Department on its card."
                   style="-fx-text-fill: #555555;"/>
        </HBox>

        <!-- MESSAGE LABEL -->
        <Label fx:id="messageLabel" 
               text="Total Tasks: 8"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;"/>

        <!-- TASKS LIST SECTION -->
        <VBox spacing="15" 
              style="-fx-border-color: #CCCCCC; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #FAFAFA;">

            <Label text="TASK LIST" 
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F5B99;"/>

            <!-- Tasks will be added dynamically here -->
            <VBox fx:id="tasksList" 
                  spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-alignment: TOP_LEFT;"/>

        </VBox>

        <!-- FOOTER BUTTONS -->
        <HBox spacing="10" style="-fx-alignment: CENTER;">
            <Button fx:id="backButton" 
                    text="BACK TO DASHBOARD"
                    prefWidth="200"
                    style="-fx-padding: 12px 20px; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #6C757D; -fx-text-fill: white; -fx-cursor: hand; -fx-border-radius: 4;"/>
        </HBox>

        <VBox style="-fx-padding: 10;"/>

    </VBox>

</ScrollPane>